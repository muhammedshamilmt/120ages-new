<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>
    {{ content_for_header }}
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
    <!-- Font Awesome for logos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>

        @keyframes text-fill {
            0% { width: 0%; }
            100% { width: 100%; }
        }

        @font-face {
            font-family: 'CrakeTest';
            src: url('{{ 'craketest-medium.otf' | asset_url }}') format('opentype');
            font-weight: normal;
        }

        @font-face {
            font-family: 'CrakeTest';
            src: url('{{ 'craketest-medium.otf' | asset_url }}') format('opentype');
            font-weight: 500;
        }

        @font-face {
            font-family: 'CrakeTest';
            src: url('{{ 'craketest-semibold.otf' | asset_url }}') format('opentype');
            font-weight: 600;
        }

        @font-face {
            font-family: 'CrakeTest';
            src: url('{{ 'craketest-semibold.otf' | asset_url }}') format('opentype');
            font-weight: bold;
        }

        :root {
            --primary-bg: #254126;
            --secondary-bg: #989D7D;
            --light-bg: #F0F0EF;
            --white: #FFFFFF;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--light-bg);
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .font-heading {
            font-family: 'Inter', sans-serif !important;
        }

        /* CrakeTest only for the brand logo text — preloader + hero h1 */
        .font-crake {
            font-family: 'CrakeTest', serif !important;
        }

        /* Hide scrollbar for Chrome, Safari and Opera */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        /* Hide scrollbar for IE, Edge and Firefox */
        .hide-scrollbar {
            -ms-overflow-style: none;
            /* IE and Edge */
            scrollbar-width: none;
            /* Firefox */
        }

        /* Marquee Animation */
        @keyframes marquee {
            0% {
                transform: translateX(0%);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .animate-marquee {
            animation: marquee 20s linear infinite;
        }

        .animate-marquee-slow {
            animation: marquee 40s linear infinite;
        }

        /* Floating Animation */
        @keyframes float {

            0%,
            100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        .animate-float {
            animation: float 6s ease-in-out infinite;
        }

        /* Custom Bounce Animation for Navbar Dots */
        @keyframes bounce-custom {

            0%,
            100% {
                height: 5px;
                background-color: #ffffff;
            }

            50% {
                height: 15px;
                background-color: #f8c630;
            }
        }

        .animate-bounce-custom {
            animation: bounce-custom 1.5s ease-in-out infinite;
        }
    
        /* Hide scrollbar for Chrome, Safari and Opera */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        /* Hide scrollbar for IE, Edge and Firefox */
        .no-scrollbar {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }

        /* Custom Checkbox — used by collection filter sidebar */
        .custom-checkbox {
            appearance: none;
            -webkit-appearance: none;
            background-color: transparent;
            margin: 0;
            font: inherit;
            color: currentColor;
            width: 1.15em;
            height: 1.15em;
            border: 1px solid var(--primary-bg);
            border-radius: 0.25em;
            display: grid;
            place-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }

        .custom-checkbox::before {
            content: "";
            width: 0.65em;
            height: 0.65em;
            transform: scale(0);
            transition: 120ms transform ease-in-out;
            box-shadow: inset 1em 1em var(--primary-bg);
            background-color: var(--primary-bg);
            transform-origin: center;
            clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
        }

        .custom-checkbox:checked::before {
            transform: scale(1);
        }

        .custom-checkbox:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    </style>
</head>
<body class="bg-[var(--light-bg)] antialiased ">

  {% section 'header' %}
  
  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'cart-drawer' %}
  
  <!-- Scripts -->
  <script>
        let lastScrollY = window.scrollY;
        let isScrolled = false;
        const navbar = document.getElementById('navbar');
        const fullMenu = document.getElementById('nav-full-menu');
        const compactMenu = document.getElementById('nav-compact-menu');
        const mobileMenu = document.getElementById('mobile-menu');

        function updateNavbarState(scrolled) {
            isScrolled = scrolled;
            if (isScrolled) {
                navbar.style.width = '250px';
                navbar.style.maxWidth = '250px';

                fullMenu.style.opacity = '0';
                fullMenu.style.pointerEvents = 'none';
                setTimeout(() => {
                    fullMenu.classList.add('hidden');
                    compactMenu.classList.remove('hidden');
                    compactMenu.style.display = 'flex';
                    // small delay to allow display:flex to apply before opacity transition
                    setTimeout(() => {
                        compactMenu.style.opacity = '1';
                    }, 50);
                }, 300);
            } else {
                navbar.style.width = '90%';
                navbar.style.maxWidth = '650px';

                compactMenu.style.opacity = '0';
                setTimeout(() => {
                    compactMenu.classList.add('hidden');
                    compactMenu.style.display = 'none';
                    fullMenu.classList.remove('hidden');
                    // small delay to allow display:block to apply before opacity transition
                    setTimeout(() => {
                        fullMenu.style.opacity = '1';
                        fullMenu.style.pointerEvents = 'auto';
                    }, 50);
                }, 300);
            }
        }

        window.addEventListener('scroll', () => {
            const currentScrollY = window.scrollY;
            const delta = currentScrollY - lastScrollY;

            if (currentScrollY > 100 && delta > 10) {
                if (!isScrolled) updateNavbarState(true);
            } else if (delta < -10 || currentScrollY < 50) {
                if (isScrolled) updateNavbarState(false);
            }

            lastScrollY = currentScrollY;
        }, { passive: true });

        function expandNavbar() {
            updateNavbarState(false);
        }

        function openMobileMenu() {
            mobileMenu.style.pointerEvents = 'auto';
            mobileMenu.style.opacity = '1';
            mobileMenu.style.transform = 'translateY(0)';
            document.body.style.overflow = 'hidden';
        }

        function closeMobileMenu() {
            mobileMenu.style.opacity = '0';
            mobileMenu.style.transform = 'translateY(-100%)';
            mobileMenu.style.pointerEvents = 'none';
            document.body.style.overflow = 'auto';
        }

        // About Us Scroll Reveal
        const revealTextContainer = document.querySelector('.reveal-text-container');
        if (revealTextContainer) {
            const words = revealTextContainer.querySelectorAll('span');
            window.addEventListener('scroll', () => {
                const rect = revealTextContainer.getBoundingClientRect();
                // Trigger area: start revealing when top of container hits 80% of viewport, finish by 30%
                const start = window.innerHeight * 0.8;
                const end = window.innerHeight * 0.3;

                let progress = (start - rect.top) / (start - end);
                progress = Math.max(0, Math.min(1, progress));

                const wordsToReveal = Math.floor(progress * words.length);

                words.forEach((word, index) => {
                    if (index < wordsToReveal) {
                        word.classList.remove('opacity-20');
                        word.classList.add('opacity-100');
                    } else {
                        word.classList.add('opacity-20');
                        word.classList.remove('opacity-100');
                    }
                });
            }, { passive: true });
            // Mission Parallax Effect
            const parallaxBg = document.querySelector('.parallax-bg');
            if (parallaxBg) {
                window.addEventListener('scroll', () => {
                    const scrolled = window.pageYOffset;
                    // Subtle parallax on scroll
                    parallaxBg.style.transform = `translateY(${scrolled * 0.1}px)`;
                }, { passive: true });
            }
            // Trigger once on load in case it's already in view
            window.dispatchEvent(new Event('scroll'));
        }

        // Preloader Logic
        let preloaderHasRun = false;

        const initPreloader = () => {
            const preloader = document.getElementById('preloader');
            if (!preloader) return;

            // If in Shopify Theme Editor, hide immediately to prevent blocking
            if (window.Shopify && window.Shopify.designMode) {
                preloader.style.display = 'none';
                document.body.style.overflow = 'auto';
                return;
            }

            // Only run once per page load — prevents re-lock when shopify:section:load fires
            if (preloaderHasRun) return;
            preloaderHasRun = true;

            const rows = document.querySelectorAll('.preloader-row');
            document.body.style.overflow = 'hidden';

            // Step 1 — wait for the text animation to finish (2500ms), then fade text out
            setTimeout(() => {
                const preText = document.getElementById('preloader-text');
                if (preText) preText.style.opacity = '0';

                // Step 2 — after text fades (300ms), collapse the rows (each row has its own CSS transition + delay)
                setTimeout(() => {
                    rows.forEach(row => {
                        row.style.transform = 'scaleY(0)';
                    });

                    // Step 3 — last row finishes at 1000ms + 400ms delay = 1400ms, add 100ms buffer then hide
                    setTimeout(() => {
                        document.body.style.overflow = 'auto';
                        preloader.style.display = 'none';
                    }, 1600);
                }, 400);
            }, 2500);
        };

        // Run on initial load
        initPreloader();

        // Re-run when Shopify Editor re-renders a section (guard inside prevents re-lock)
        document.addEventListener('shopify:section:load', initPreloader);

    </script>


<script src="{{ 'cart.js' | asset_url }}"></script>
</body>
</html>