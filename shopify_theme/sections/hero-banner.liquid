    <!-- Hero Section Container -->
    <div class="relative w-full h-[100vh] bg-[var(--light-bg)] rounded-[2rem] overflow-hidden flex flex-col shadow-2xl">

        <!-- Main Content Area — pt-24 gives space below the fixed navbar -->
        <div class="flex-grow flex flex-col relative z-10 px-8 md:px-12 pb-10 pt-24">

            <!-- Top Section -->
            <div class="flex flex-col xl:flex-row justify-between items-start xl:items-start w-full">
                <!-- Big Heading -->
                <h1 class="font-crake text-[5rem] md:text-[12rem] lg:text-[11rem] xl:text-[13rem] font-medium leading-[0.8] tracking-[-0.03em] text-[var(--primary-bg)] -ml-2">
                    120ages<sup class="text-3xl md:text-6xl xl:text-7xl font-normal relative -top-[2.5rem] md:-top-[4.5rem] xl:-top-[6rem] -ml-2 xl:-ml-4">®</sup>
                </h1>

                <!-- Right Info Box -->
                <div class="mt-12 xl:mt-6 max-w-[320px] xl:ml-auto">
                    <div class="flex items-center mb-6">
                        <div class="flex -space-x-3">
                            <img src="https://i.pravatar.cc/100?img=11" alt="User 1" class="w-10 h-10 rounded-full border-2 border-[#f4f4f4] relative z-10 grayscale" />
                            <img src="https://i.pravatar.cc/100?img=47" alt="User 2" class="w-10 h-10 rounded-full border-2 border-[#f4f4f4] relative z-10 grayscale" />
                            <img src="https://i.pravatar.cc/100?img=12" alt="User 3" class="w-10 h-10 rounded-full border-2 border-[#f4f4f4] relative z-20 grayscale" />
                        </div>
                        <span class="text-[11px] font-bold ml-4 text-[var(--light-bg)]">[ BUILT TO ENDURE ]</span>
                    </div>
                    <p class="text-[var(--light-bg)]/80 text-[15px] leading-relaxed">
                        {{ section.settings.subheading }}
                    </p>
                </div>
            </div>

            <div class="flex-grow"></div>

            <!-- Bottom Section -->
            <div class="flex flex-col lg:flex-row justify-between items-end mt-48 lg:mt-auto relative z-20 w-full">

                <!-- Left: Trusted label -->
                <div class="text-white mb-8 lg:mb-2 max-w-[420px]">
                    <p class="text-[13px] font-medium leading-relaxed mb-6 text-white">
                        {{ section.settings.trusted_label }}
                    </p>
                    <div class="flex flex-wrap gap-x-8 gap-y-4 items-center text-[13px] font-semibold text-white">
                        <div class="flex items-center space-x-2 hover:opacity-70 transition cursor-pointer">
                            <i class="fa-solid fa-cloud"></i> <span>CloudWatch</span>
                        </div>
                        <div class="flex items-center space-x-2 hover:opacity-70 transition cursor-pointer">
                            <i class="fa-solid fa-bolt"></i> <span>Boltshift</span>
                        </div>
                        <div class="flex items-center space-x-2 hover:opacity-70 transition cursor-pointer">
                            <i class="fa-solid fa-link"></i> <span>Interlock</span>
                        </div>
                        <div class="flex items-center space-x-2 hover:opacity-70 transition cursor-pointer">
                            <i class="fa-brands fa-envira"></i> <span>Epicurious</span>
                        </div>
                        <div class="flex items-center space-x-2 hover:opacity-70 transition cursor-pointer">
                            <i class="fa-solid fa-shapes"></i> <span>Sisyphus</span>
                        </div>
                        <div class="flex items-center space-x-2 hover:opacity-70 transition cursor-pointer">
                            <i class="fa-solid fa-asterisk"></i> <span>Nietzsche</span>
                        </div>
                    </div>
                </div>

                <!-- Right: Highlight Card — fully editable -->
                <div class="bg-[var(--light-bg)]/90 backdrop-blur-md rounded-3xl p-2 w-[300px] shadow-2xl">
                    <div class="bg-[#f0f0f0] rounded-[1.25rem] h-[170px] mb-3 overflow-hidden relative group cursor-pointer">
                        {% if section.settings.card_image != blank %}
                            <img src="{{ section.settings.card_image | img_url: 'master' }}"
                                alt="{{ section.settings.card_title | escape }}"
                                class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        {% else %}
                            <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=600&auto=format&fit=crop&q=60"
                                alt="120ages Farms Project"
                                class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        {% endif %}
                    </div>
                    <div class="px-3 pb-2 pt-1 flex justify-between items-end">
                        <div>
                            <h3 class="font-bold text-[var(--primary-bg)] text-base">
                                {{ section.settings.card_title | default: '120ages Farms' }}<sup class="text-[10px] font-medium ml-0.5">®</sup>
                            </h3>
                            <p class="text-[11px] font-medium text-[var(--secondary-bg)] mt-1">
                                {{ section.settings.card_subtitle | default: 'Organic Harvest - 2026*' }}
                            </p>
                        </div>
                        <a href="{{ section.settings.card_link | default: routes.collections_url }}"
                            class="w-8 h-8 bg-neutral-100 rounded-full flex items-center justify-center hover:bg-[var(--secondary-bg)] transition text-[var(--secondary-bg)]">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 17L17 7M17 7H7M17 7V17" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Background Image — full height, no top gap -->
        <div class="absolute inset-0 z-0 pointer-events-none">
            <!-- Top fade so heading text stays readable -->
            <div class="absolute inset-0 bg-gradient-to-b from-[#f4f4f4]/80 via-transparent to-transparent z-10 h-[35%]"></div>

            {% if section.settings.bg_image != blank %}
            <img src="{{ section.settings.bg_image | img_url: 'master' }}"
                alt="Hero Background"
                class="w-full h-full object-cover object-center" />
            {% else %}
            <img src="{{ 'herobg.png' | asset_url }}"
                alt="Hero Background"
                class="w-full h-full object-cover object-center" />
            {% endif %}

            <!-- Bottom dark gradient for text readability -->
            <div class="absolute bottom-0 left-0 w-full h-full bg-gradient-to-t from-black/50 via-black/10 to-transparent z-10"></div>
        </div>

    </div>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fuel your body with the purest ancient grains. Premium organic superfoods, responsibly sourced to elevate your everyday wellness."
    },
    {
      "type": "text",
      "id": "trusted_label",
      "label": "Trusted-by label",
      "default": "Trusted by families and chefs turning organic harvests into nourishing everyday meals."
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero background image"
    },
    {
      "type": "header",
      "content": "Highlight Card (bottom right)"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Card image"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "120ages Farms"
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Card subtitle",
      "default": "Organic Harvest - 2026*"
    },
    {
      "type": "url",
      "id": "card_link",
      "label": "Card link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
