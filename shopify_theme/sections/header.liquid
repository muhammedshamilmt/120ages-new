{% if template.name == 'index' %}
    <div id="preloader" style="position:fixed;inset:0;z-index:9999;width:100%;height:100vh;">
        <!-- Slicing Background -->
        <div style="position:absolute;inset:0;display:grid;grid-template-rows:repeat(5,1fr);width:100%;height:100%;">
            <div class="preloader-row" style="width:100%;height:100%;background:#254126;transform-origin:top;transform:scaleY(1);transition:transform 1000ms cubic-bezier(0.85,0,0.15,1) 0ms;"></div>
            <div class="preloader-row" style="width:100%;height:100%;background:#254126;transform-origin:top;transform:scaleY(1);transition:transform 1000ms cubic-bezier(0.85,0,0.15,1) 100ms;"></div>
            <div class="preloader-row" style="width:100%;height:100%;background:#254126;transform-origin:top;transform:scaleY(1);transition:transform 1000ms cubic-bezier(0.85,0,0.15,1) 200ms;"></div>
            <div class="preloader-row" style="width:100%;height:100%;background:#254126;transform-origin:top;transform:scaleY(1);transition:transform 1000ms cubic-bezier(0.85,0,0.15,1) 300ms;"></div>
            <div class="preloader-row" style="width:100%;height:100%;background:#254126;transform-origin:top;transform:scaleY(1);transition:transform 1000ms cubic-bezier(0.85,0,0.15,1) 400ms;"></div>
        </div>

        <div id="preloader-text"
            style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;transition:opacity 1000ms ease-in-out;z-index:10;">
            <h1 class="font-crake" style="font-size:8rem;font-weight:600;position:relative;display:inline-block;color:rgba(240,240,239,0.2);font-family:'CrakeTest',serif;">
                120ages
                <span style="position:absolute;top:0;left:0;color:#f8c630;overflow:hidden;white-space:nowrap;animation:text-fill 2.5s cubic-bezier(0.7,0,1,1) forwards;">
                    120ages
                </span>
            </h1>
        </div>
    </div>
{% endif %}


    <!-- New Fixed Navbar -->
    <div id="navbar"
        class="fixed top-6 py-3 left-1/2 -translate-x-1/2 z-[100] flex items-center justify-between bg-[var(--primary-bg)] pl-1 py-0.5 rounded-full border border-[var(--light-bg)]/10 shadow-[0_10px_30px_rgba(0,0,0,0.5)] overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] w-[90%] max-w-[650px]">

        <a href="{{ routes.root_url }}"
            class="hover:text-[var(--light-bg)] transition-colors z-10 flex items-center gap-2 text-[var(--light-bg)] font-bold text-md tracking-tight pl-2 whitespace-nowrap">
            <span class="ml-1">120ages®</span>
        </a>

        <!-- Full Menu -->
        <div id="nav-full-menu" class="flex items-center ml-2 transition-all duration-300 opacity-100">
            <!-- Desktop Links -->
            <div
                class="hidden md:flex items-center gap-6 text-[var(--light-bg)]/90 text-sm font-medium pr-4 whitespace-nowrap border-r border-[var(--light-bg)]/20 mr-4">
                <a href="{{ routes.root_url }}" class="text-white hover:text-gray-300 transition-colors">Home</a>
                <a href="/collections/test" class="text-white hover:text-gray-300 transition-colors">Collection</a>
                
                <a href="/pages/contact" class="text-white hover:text-gray-300 transition-colors">Contact</a>
            </div>

            <!-- E-commerce Icons -->
            <div class="hidden md:flex items-center gap-5 text-[var(--light-bg)] pr-3">
                <button class="hover:text-[#f8c630] transition-colors">
                    <i class="fa-solid fa-bell text-lg"></i>
                </button>
                <button class="hover:text-[#f8c630] transition-colors" onclick="openCart()">
                    <i class="fa-solid fa-cart-shopping text-lg"></i>
                </button>
                <button class="hover:text-[#f8c630] transition-colors">
                    <i class="fa-solid fa-user text-lg"></i>
                </button>
            </div>

            <!-- Mobile Hamburger Icon -->
            <div class="md:hidden flex items-center justify-center p-2 pr-3 cursor-pointer" onclick="openMobileMenu()">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f8c630" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </div>
        </div>

        <!-- Compact Menu (3 dots) -->
        <div id="nav-compact-menu"
            class="hidden absolute right-1 items-center justify-center pr-2 h-[40px] cursor-pointer group opacity-0 transition-opacity duration-300"
            onclick="expandNavbar()">
            <div class="flex items-end gap-1.5 h-[16px]">
                <div class="w-1.5 rounded-full bg-[var(--light-bg)] animate-bounce-custom" style="animation-delay: 0s">
                </div>
                <div class="w-1.5 rounded-full bg-[var(--light-bg)] animate-bounce-custom"
                    style="animation-delay: 0.5s"></div>
                <div class="w-1.5 rounded-full bg-[var(--light-bg)] animate-bounce-custom"
                    style="animation-delay: 1.0s"></div>
            </div>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu"
        class="fixed inset-0 z-[110] bg-[var(--primary-bg)] flex flex-col items-center justify-center gap-8 translate-y-[-100%] opacity-0 transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] pointer-events-none">
        <!-- Close Button -->
        <div class="absolute top-8 right-8 text-[var(--light-bg)]/50 hover:text-[var(--light-bg)] cursor-pointer transition-colors p-4"
            onclick="closeMobileMenu()">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </div>

        <!-- Links -->
        <div class="flex flex-col items-center gap-8 text-4xl font-bold tracking-tighter mt-16">
            <a href="{{ routes.root_url }}" onclick="closeMobileMenu()"
                class="text-[var(--light-bg)] hover:text-[#f8c630] transition-colors">Home</a>
            <a href="/collections/test" onclick="closeMobileMenu()"
                class="text-[var(--light-bg)] hover:text-[#f8c630] transition-colors">Collection</a>
            
            <a href="/pages/contact" onclick="closeMobileMenu()"
                class="text-[#f8c630] hover:text-[var(--light-bg)] transition-colors mt-8">Contact</a>
        </div>
    </div>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
