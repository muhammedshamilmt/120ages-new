    <!-- Fresh Approach Section -->
    <section class="w-full max-w-[1400px] mx-auto px-8 md:px-12 py-24">

        <!-- Top Row -->
        <div class="flex flex-col md:flex-row justify-between items-start gap-12 md:gap-24 mb-20">
            <div class="w-full md:w-[45%]">
                <div class="w-10 h-[2px] bg-[var(--primary-bg)] mb-8"></div>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-[var(--primary-bg)] leading-[1.15]">
                    {{ section.settings.heading }}
                </h2>
            </div>
            <div class="w-full md:w-[50%] md:pt-12">
                <p class="text-[var(--secondary-bg)] text-[16px] leading-relaxed max-w-lg">
                    {{ section.settings.body }}
                </p>
            </div>
        </div>

        <!-- Divider -->
        <div class="w-full h-[1px] bg-[var(--primary-bg)]/10 mb-20"></div>

        <!-- Feature Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-16">

            <!-- Item 1 -->
            <div class="flex flex-col gap-6 group cursor-default">
                <div class="w-14 h-14 rounded-2xl bg-[var(--primary-bg)]/5 flex items-center justify-center text-[var(--primary-bg)] transition-transform duration-500 group-hover:-translate-y-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                        <path d="M2 22 12 12"/>
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-[var(--primary-bg)] text-[15px] tracking-tight mb-1">{{ section.settings.feature_1_title }}</h4>
                    <p class="text-[var(--secondary-bg)] text-[13px] leading-relaxed">{{ section.settings.feature_1_desc }}</p>
                </div>
            </div>

            <!-- Item 2 -->
            <div class="flex flex-col gap-6 group cursor-default">
                <div class="w-14 h-14 rounded-2xl bg-[var(--primary-bg)]/5 flex items-center justify-center text-[var(--primary-bg)] transition-transform duration-500 group-hover:-translate-y-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="7" y="10" width="10" height="12" rx="2"/>
                        <path d="M7 10h10v0c0-1.66-1.34-3-3-3h-4c-1.66 0-3 1.34-3 3v0z"/>
                        <path d="M9 7v-3h6v3"/>
                        <path d="M12 4v-2"/><path d="M10 2h4"/>
                        <path d="M4 14c-1.1 0-2-.9-2-2 0-1.1 1-2.5 2-4 1 1.5 2 2.9 2 4 0 1.1-.9 2-2 2z"/>
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-[var(--primary-bg)] text-[15px] tracking-tight mb-1">{{ section.settings.feature_2_title }}</h4>
                    <p class="text-[var(--secondary-bg)] text-[13px] leading-relaxed">{{ section.settings.feature_2_desc }}</p>
                </div>
            </div>

            <!-- Item 3 -->
            <div class="flex flex-col gap-6 group cursor-default">
                <div class="w-14 h-14 rounded-2xl bg-[var(--primary-bg)]/5 flex items-center justify-center text-[var(--primary-bg)] transition-transform duration-500 group-hover:-translate-y-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 16a3 3 0 0 1 2.24 5"/>
                        <path d="M18 12h.01"/>
                        <path d="M18 21h-8a4 4 0 0 1-4-4 7 7 0 0 1 7-7h.2L9.6 6.4a1 1 0 1 1 2.8-2.8L15.8 7h.2c3.3 0 6 2.7 6 6v1a2 2 0 0 1-2 2h-1a3 3 0 0 0-3 3"/>
                        <path d="M20 8.54V4a2 2 0 1 0-4 0v3"/>
                        <path d="M7.612 12.524a3 3 0 1 0-1.6 4.3"/>
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-[var(--primary-bg)] text-[15px] tracking-tight mb-1">{{ section.settings.feature_3_title }}</h4>
                    <p class="text-[var(--secondary-bg)] text-[13px] leading-relaxed">{{ section.settings.feature_3_desc }}</p>
                </div>
            </div>

            <!-- Item 4 -->
            <div class="flex flex-col gap-6 group cursor-default">
                <div class="w-14 h-14 rounded-2xl bg-[var(--primary-bg)]/5 flex items-center justify-center text-[var(--primary-bg)] transition-transform duration-500 group-hover:-translate-y-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 22c-2.2 0-4-1.8-4-4 0-2.2 2-5.1 4-8 2 2.9 4 5.8 4 8 0 2.2-1.8 4-4 4z"/>
                        <path d="M8 18c-1.6 0-3-1.4-3-3 0-1.7 1.5-3.8 3-6 1.5 2.2 3 4.3 3 6 0 1.6-1.4 3-3 3z"/>
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-[var(--primary-bg)] text-[15px] tracking-tight mb-1">{{ section.settings.feature_4_title }}</h4>
                    <p class="text-[var(--secondary-bg)] text-[13px] leading-relaxed">{{ section.settings.feature_4_desc }}</p>
                </div>
            </div>

        </div>
    </section>

{% schema %}
{
  "name": "Fresh Approach",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "our fresh approach to grooming."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Our men's body wash can handle your dirty sides. Made without parabens + phthalates, it's packed with plant-based cleansers that lather quickly and rinse clean."
    },
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "nature-inspired scents."
    },
    {
      "type": "text",
      "id": "feature_1_desc",
      "label": "Description",
      "default": "Drawn from botanicals that ground and refresh."
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "no added parabens."
    },
    {
      "type": "text",
      "id": "feature_2_desc",
      "label": "Description",
      "default": "Clean formulas, nothing your skin doesn't need."
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "animal cruelty-free."
    },
    {
      "type": "text",
      "id": "feature_3_desc",
      "label": "Description",
      "default": "Ethically made, every step of the way."
    },
    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "text",
      "id": "feature_4_title",
      "label": "Title",
      "default": "lather and rinse clean."
    },
    {
      "type": "text",
      "id": "feature_4_desc",
      "label": "Description",
      "default": "Rich foam, zero residue left behind."
    }
  ],
  "presets": [{"name": "Fresh Approach"}]
}
{% endschema %}
