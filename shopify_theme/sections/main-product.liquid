
<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .thumb-btn { transition: border-color 0.2s, opacity 0.2s; }
  .thumb-btn.active { border-color: var(--primary-bg); opacity: 1; }
  .thumb-btn:not(.active) { opacity: 0.6; }
  .variant-btn { transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .variant-btn.active { background: var(--primary-bg); color: #fff; }
</style>

<!-- Filters bar (matches product-details.html top bar) -->
<div class="w-full px-8 py-4 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--primary-bg)]/10 bg-white">
  <div class="flex items-center gap-3">
    <button class="px-4 py-2 bg-transparent rounded-full border border-gray-200 text-sm font-medium flex items-center gap-2 hover:border-[var(--primary-bg)] transition">
      Categories <i class="fa-solid fa-chevron-down text-xs text-gray-400"></i>
    </button>
    <a href="{{ routes.collections_url }}" class="px-4 py-2 bg-transparent rounded-full border border-gray-200 text-sm font-medium flex items-center gap-2 hover:border-[var(--primary-bg)] transition">
      Collections <i class="fa-solid fa-chevron-down text-xs text-gray-400"></i>
    </a>
  </div>
  <div class="flex-1 max-w-xl relative">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="text" name="q" placeholder="Search..."
        class="w-full bg-[var(--light-bg)] rounded-full py-2 pl-5 pr-10 border-none text-sm focus:outline-none focus:ring-1 focus:ring-[var(--primary-bg)] transition">
      <button type="submit" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </form>
  </div>
  <div class="flex items-center gap-3 flex-wrap">
    {%- for type in shop.types limit: 4 -%}
      <a href="{{ routes.collections_url }}?q={{ type | url_encode }}"
        class="px-4 py-2 bg-transparent rounded-full border border-gray-200 text-sm font-medium hover:border-[var(--primary-bg)] transition">
        {{ type }}
      </a>
    {%- endfor -%}
  </div>
</div>

<main class="w-full max-w-7xl mx-auto px-8 py-8 bg-white">

  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-xs font-medium text-gray-400 mb-8">
    <a href="{{ routes.root_url }}" class="hover:text-[var(--primary-bg)] transition">
      <i class="fa-solid fa-arrow-left mr-2"></i>Home
    </a>
    <span>•</span>
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}" class="hover:text-[var(--primary-bg)] transition">
        {{ product.collections.first.title }}
      </a>
      <span>•</span>
    {%- endif -%}
    <span class="text-[var(--primary-bg)]">{{ product.title }}</span>
  </div>

  <!-- Product Hero -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20">

    <!-- Left: Image Gallery -->
    <div class="w-full h-[650px] bg-[var(--light-bg)] rounded-[2.5rem] overflow-hidden relative flex flex-col">
      <!-- Progress dots -->
      <div class="absolute top-8 left-0 w-full px-10 flex gap-2 z-10">
        {%- for image in product.images limit: 3 -%}
          <div class="h-1 {% if forloop.first %}bg-[var(--primary-bg)]{% else %}bg-white/50{% endif %} flex-1 rounded-full overflow-hidden" id="progress-{{ forloop.index }}"></div>
        {%- endfor -%}
      </div>

      <!-- Main Image -->
      <div class="absolute inset-0 w-full h-full pb-36 pt-4 px-4 flex items-center justify-center">
        <img id="mainImage"
          src="{{ product.featured_image | img_url: 'master' }}"
          alt="{{ product.title | escape }}"
          class="w-full h-full object-contain mix-blend-multiply transition-opacity duration-300">
      </div>

      {% if product.compare_at_price > product.price %}
        <span class="absolute top-8 right-8 bg-[#f8c630] text-[var(--primary-bg)] text-xs font-bold px-4 py-2 rounded-full z-10">Sale</span>
      {% endif %}

      <!-- Thumbnails -->
      <div class="flex justify-center gap-3 mt-auto mb-4 relative z-10 px-4 flex-wrap">
        {%- for image in product.images limit: 4 -%}
        <button type="button"
          onclick="switchImage('{{ image | img_url: 'master' }}', this, {{ forloop.index }})"
          class="thumb-btn w-24 h-24 bg-white rounded-2xl overflow-hidden border-4 border-[var(--primary-bg)]/50 hover:border-[var(--primary-bg)] shadow-sm {% if forloop.first %}active{% endif %}">
          <img src="{{ image | img_url: '200x' }}"
            alt="{{ product.title | escape }} - image {{ forloop.index }}"
            class="w-full h-full object-contain mix-blend-multiply">
        </button>
        {%- endfor -%}
      </div>
    </div>

    <!-- Right: Product Details -->
    <div class="flex flex-col py-2">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">{{ product.type }}</span>
      <h1 class="font-heading text-4xl text-[var(--primary-bg)] mb-4">{{ product.title }}</h1>

      <!-- Price -->
      <div class="flex items-end gap-4 mb-4">
        <span class="text-3xl font-bold text-[var(--primary-bg)]" id="product-price">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="text-xl font-medium text-[var(--secondary-bg)] line-through mb-1">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      <!-- Delivery info -->
      <div class="w-full bg-[var(--light-bg)] rounded-full py-3 px-5 flex items-center gap-3 mb-8">
        <i class="fa-regular fa-clock text-[var(--primary-bg)]"></i>
        <p class="text-sm font-medium text-[var(--primary-bg)]">Order today for fast delivery</p>
      </div>

      <!-- Variants -->
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-[var(--primary-bg)] mb-3">{{ option.name }}</h3>
          <div class="flex flex-wrap gap-3" id="option-{{ forloop.index }}">
            {%- for value in option.values -%}
            <button type="button"
              data-option-index="{{ forloop.parentloop.index0 }}"
              data-option-value="{{ value | escape }}"
              onclick="selectVariantOption(this)"
              class="variant-btn px-5 py-2.5 rounded-full border border-[var(--primary-bg)]/40 text-sm font-semibold text-[var(--primary-bg)] hover:border-[var(--primary-bg)] {% if option.selected_value == value %}active{% endif %}">
              {{ value }}
            </button>
            {%- endfor -%}
          </div>
        </div>
        {%- endfor -%}
      {%- endunless -%}

      <!-- Add to Cart Form -->
      {%- form 'product', product, id: 'product-form' -%}
        <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <!-- Quantity -->
          <div class="flex items-center justify-between border border-[var(--primary-bg)] rounded-full px-4 py-2 w-full sm:w-[140px] h-[58px]">
            <button type="button"
              onclick="this.nextElementSibling.stepDown()"
              class="w-8 h-8 flex items-center justify-center text-[var(--primary-bg)] hover:bg-[var(--primary-bg)]/10 rounded-full transition">
              <i class="fa-solid fa-minus text-xs"></i>
            </button>
            <input type="number" name="quantity" value="1" min="1"
              class="w-10 text-center bg-transparent text-lg font-bold text-[var(--primary-bg)] focus:outline-none">
            <button type="button"
              onclick="this.previousElementSibling.stepUp()"
              class="w-8 h-8 flex items-center justify-center text-[var(--primary-bg)] hover:bg-[var(--primary-bg)]/10 rounded-full transition">
              <i class="fa-solid fa-plus text-xs"></i>
            </button>
          </div>

          <!-- Add to Cart button -->
          <button type="submit"
            id="add-to-cart-btn"
            class="flex-1 h-[58px] bg-[var(--primary-bg)] text-[var(--light-bg)] rounded-full font-bold text-lg hover:bg-[#1a2d1a] transition shadow-[0_10px_20px_rgba(37,65,38,0.2)] flex items-center justify-center gap-3 group
            {%- unless product.available %} opacity-50 cursor-not-allowed{%- endunless -%}"
            {%- unless product.available -%}disabled{%- endunless -%}>
            {%- if product.available -%}
              <i class="fa-solid fa-cart-shopping group-hover:scale-110 transition-transform"></i>
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>

          <!-- Wishlist -->
          <button type="button"
            class="w-[58px] h-[58px] rounded-full border border-gray-300 flex items-center justify-center text-gray-400 hover:text-[var(--primary-bg)] hover:border-[var(--primary-bg)] transition shrink-0">
            <i class="fa-regular fa-heart text-xl"></i>
          </button>
        </div>
      {%- endform -%}

      <!-- Accordions -->
      <!-- Description -->
      <div class="border border-gray-200 rounded-3xl overflow-hidden mb-4 hover:border-[var(--primary-bg)] transition">
        <button type="button"
          onclick="toggleAccordion(this)"
          class="w-full flex justify-between items-center p-5 cursor-pointer text-left">
          <h3 class="font-bold text-[var(--primary-bg)]">Description & Details</h3>
          <i class="fa-solid fa-chevron-up text-sm text-[var(--primary-bg)] transition-transform accordion-icon"></i>
        </button>
        <div class="accordion-content px-5 pb-5 text-sm text-gray-500 leading-relaxed">
          {{ product.description | default: 'No description available.' }}
        </div>
      </div>

      <!-- Shipping -->
      <div class="border border-gray-200 rounded-3xl overflow-hidden hover:border-[var(--primary-bg)] transition">
        <button type="button"
          onclick="toggleAccordion(this)"
          class="w-full flex justify-between items-center p-5 cursor-pointer text-left">
          <h3 class="font-bold text-[var(--primary-bg)]">Shipping & Returns</h3>
          <i class="fa-solid fa-chevron-down text-sm text-gray-400 transition-transform accordion-icon"></i>
        </button>
        <div class="accordion-content hidden px-5 pb-5 grid grid-cols-2 gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[var(--light-bg)] flex items-center justify-center shrink-0">
              <i class="fa-solid fa-truck text-xs text-[var(--primary-bg)]"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-500 font-medium">Delivery Time</p>
              <p class="text-sm font-bold text-[var(--primary-bg)]">3–4 Working Days</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[var(--light-bg)] flex items-center justify-center shrink-0">
              <i class="fa-solid fa-rotate-left text-xs text-[var(--primary-bg)]"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-500 font-medium">Returns</p>
              <p class="text-sm font-bold text-[var(--primary-bg)]">30-Day Free Returns</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[var(--light-bg)] flex items-center justify-center shrink-0">
              <i class="fa-solid fa-box text-xs text-[var(--primary-bg)]"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-500 font-medium">Package</p>
              <p class="text-sm font-bold text-[var(--primary-bg)]">Eco-Friendly Packaging</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[var(--light-bg)] flex items-center justify-center shrink-0">
              <i class="fa-solid fa-tag text-xs text-[var(--primary-bg)]"></i>
            </div>
            <div>
              <p class="text-[10px] text-gray-500 font-medium">Free Shipping</p>
              <p class="text-sm font-bold text-[var(--primary-bg)]">On orders over $100</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Rating & Reviews Section -->
  <div class="w-full pt-12 pb-16 border-t border-gray-100 flex flex-col md:flex-row gap-16 items-start">
    <div class="w-full md:w-1/3">
      <h2 class="text-2xl font-bold text-[var(--primary-bg)] mb-8">Rating & Reviews</h2>
      <div class="flex items-end gap-2 mb-4">
        <span class="text-7xl font-heading font-bold text-[var(--primary-bg)] leading-none">4.5</span>
        <span class="text-2xl text-gray-400 font-bold mb-2">/5</span>
      </div>
      <p class="text-sm text-gray-400 font-medium mb-8">Based on customer reviews</p>
      <div class="flex flex-col gap-3">
        {%- assign bars = '5,4,3,2,1' | split: ',' -%}
        {%- assign widths = '80,20,0,0,0' | split: ',' -%}
        {%- for bar in bars -%}
        <div class="flex items-center gap-3">
          <span class="flex items-center text-sm font-bold gap-1 text-[#f8c630] w-8">
            <i class="fa-solid fa-star text-xs"></i> {{ bar }}
          </span>
          <div class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-[var(--primary-bg)] rounded-full" style="width: {{ widths[forloop.index0] }}%"></div>
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Review card -->
    <div class="w-full md:w-2/3 md:pl-10 md:pt-16">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h4 class="font-bold text-[var(--primary-bg)]">Verified Customer</h4>
          <div class="flex text-[#f8c630] text-xs gap-1 mt-1">
            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
          </div>
        </div>
        <span class="text-xs text-gray-400 font-medium">{{ 'now' | date: '%b %Y' }}</span>
      </div>
      <p class="text-sm text-gray-500 leading-relaxed mb-6">
        "120ages's dedication to sustainability and ethical practices resonates strongly. Premium quality grains that have genuinely improved our daily meals — we won't go back."
      </p>
      <div class="flex justify-between items-end">
        <div class="w-10 h-10 rounded-full bg-gray-200 overflow-hidden">
          <img src="https://ui-avatars.com/api/?name=Customer&background=f0f0ef&color=254126" alt="Reviewer" class="w-full h-full object-cover">
        </div>
        <div class="flex gap-2">
          <div class="w-12 h-1 bg-[var(--primary-bg)] rounded-full"></div>
          <div class="w-12 h-1 bg-gray-200 rounded-full"></div>
        </div>
        <button class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:text-[var(--primary-bg)] hover:border-[var(--primary-bg)] transition">
          <i class="fa-solid fa-chevron-right text-xs"></i>
        </button>
      </div>
    </div>
  </div>

</main>

<!-- Variant + image JS -->
<script>
  // Image switcher
  function switchImage(src, btn, index) {
    document.getElementById('mainImage').src = src;
    document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    // update progress bars
    document.querySelectorAll('[id^="progress-"]').forEach((bar, i) => {
      bar.className = bar.className.replace('bg-[var(--primary-bg)]', 'bg-white/50').replace('bg-white/50', 'bg-white/50');
      if (i + 1 === index) bar.className = bar.className.replace('bg-white/50', 'bg-[var(--primary-bg)]');
    });
  }

  // Accordion
  function toggleAccordion(btn) {
    const content = btn.nextElementSibling;
    const icon = btn.querySelector('.accordion-icon');
    const isHidden = content.classList.contains('hidden');
    if (isHidden) {
      content.classList.remove('hidden');
      icon.classList.remove('fa-chevron-down', 'text-gray-400');
      icon.classList.add('fa-chevron-up', 'text-[var(--primary-bg)]');
    } else {
      content.classList.add('hidden');
      icon.classList.remove('fa-chevron-up', 'text-[var(--primary-bg)]');
      icon.classList.add('fa-chevron-down', 'text-gray-400');
    }
  }

  // Variant selector
  var productVariants = {{ product.variants | json }};

  function selectVariantOption(btn) {
    var optionIndex = parseInt(btn.dataset.optionIndex);
    var value = btn.dataset.optionValue;

    // Update active state for this option group
    btn.closest('div[id^="option-"]').querySelectorAll('.variant-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    // Collect current selected values for all options
    var selectedOptions = [];
    document.querySelectorAll('div[id^="option-"]').forEach(function(group) {
      var activeBtn = group.querySelector('.variant-btn.active');
      selectedOptions.push(activeBtn ? activeBtn.dataset.optionValue : null);
    });

    // Find matching variant
    var matchedVariant = productVariants.find(function(v) {
      return v.options.every(function(opt, i) {
        return selectedOptions[i] === null || opt === selectedOptions[i];
      });
    });

    if (matchedVariant) {
      document.getElementById('variant-id').value = matchedVariant.id;
      // Update price
      var priceEl = document.getElementById('product-price');
      if (priceEl && matchedVariant.price) {
        priceEl.textContent = formatMoney(matchedVariant.price);
      }
      // Update availability
      var addBtn = document.getElementById('add-to-cart-btn');
      if (addBtn) {
        if (matchedVariant.available) {
          addBtn.disabled = false;
          addBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          addBtn.innerHTML = '<i class="fa-solid fa-cart-shopping group-hover:scale-110 transition-transform"></i> Add to Cart';
        } else {
          addBtn.disabled = true;
          addBtn.classList.add('opacity-50', 'cursor-not-allowed');
          addBtn.innerHTML = 'Sold Out';
        }
      }
      // Update main image if variant has an image
      if (matchedVariant.featured_image) {
        document.getElementById('mainImage').src = matchedVariant.featured_image.src;
      }
    }
  }

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }
</script>

{% schema %}
{
  "name": "Product Information",
  "settings": [],
  "presets": [{"name": "Product Information"}]
}
{% endschema %}
